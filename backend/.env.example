# Porta da API (o frontend faz proxy de /api para esta porta)
PORT=3333

# Conexão com o SQL Server no formato de URL do Prisma.
# Não coloque credenciais reais neste arquivo; copie-o para ".env" e ajuste lá.

# 1) Autenticação do Windows (equivale a Trusted_Connection=True) em instância nomeada.
#    Requer TCP/IP habilitado na instância e o serviço "SQL Server Browser" em execução (veja o README).
DATABASE_URL="sqlserver://localhost\SQLEXPRESS;database=curriculos;integratedSecurity=true;trustServerCertificate=true"

# 2) Autenticação do Windows com porta TCP fixa (dispensa o SQL Server Browser):
# DATABASE_URL="sqlserver://localhost:1433;database=curriculos;integratedSecurity=true;trustServerCertificate=true"

# 3) Login do SQL Server (usuário e senha):
# DATABASE_URL="sqlserver://localhost:1433;database=curriculos;user=SEU_USUARIO;password=SUA_SENHA;trustServerCertificate=true"
