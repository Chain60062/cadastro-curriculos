{
  "name": "cadastro-curriculos-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
